{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    // composite 项目必须有产物输出。若落回仓库根目录，tsc 会生成 vite.config.js，
    // 而 Vite 解析配置时 .js 优先于 .ts —— 那份过期的编译产物会直接覆盖真正的配置
    // （曾导致 base 设置失效、Pages 子路径 404）。把输出重定向到 node_modules 内。
    "outDir": "node_modules/.tmp/tsconfig.node"
  },
  "include": ["vite.config.ts"]
}