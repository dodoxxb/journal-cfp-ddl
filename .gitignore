# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
.python-version

# Node
node_modules/
.vite/
.vitest/
*.tsbuildinfo

# 构建产物（GitHub Pages 用 public/ 已包含预生成数据，不需要 dist/）
dist/

# ── 数据湖：本地全量原始爬虫数据，不进 git ────────────────────────────────
# 这些目录可能数百 MB，超出 GitHub 仓库 1GB 软限额
data/cfp_by_publisher/
data/cfp_cache.json
data/mdpi_cfps.yml
data/elsevier_cfps.yml
data/discovered_cfps.yml

# ── 会话目录：人工辅助过反爬挑战后的 cookies / 浏览器 profile ─────────────
# 内含登录态与个人指纹，绝对不能公开
data/sessions/
data/sessions/browser/
data/sessions/cookies/

# 旧的 legacy 单体 journals.json（108MB 已被 public/data/index.json+shards 取代）
data/journals.json

# ── SCImago 指标源数据与其派生索引 ────────────────────────────────────────
# 均为 enrich_journal_meta.py 的本地输入（合计约 19MB），第三方数据不宜随仓库分发。
# 真正上线的产物是 public/data/journal_meta.json（99KB）。
data/scimagojr*.csv
data/scimago*.csv
data/scimago_metrics_compact.json
data/scimago_title_index.json
data/journal_meta.json

# ── 爬虫运行状态 / 期刊清单（本地运维数据） ──────────────────────────────
data/wiley_crawl_state.json
data/wiley_journals.json
data/hindawi_journals.json

# ── 归档区：退役文件放在这里只为本地可回溯，不进 git ──────────────────────
# 需要永久保留的 legacy 文件请直接删除本行后再 git add _archived/
_archived/

# 环境配置
.env
.env.local
.env.*.local

# IDE / 系统
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.DS_Store
Thumbs.db
*.swp
*.swo

# WorkBuddy / Agent 工具产物
.workbuddy/
.claude/

# 测试 / 覆盖率
coverage/
.nyc_output/

# 临时文件
*.tmp
*.bak

# 爬虫 / 构建运行日志（瞬时产物，不进 git）
*.log
# Vite 临时文件
vite.config.*.timestamp-*

# 发布导出清单（留在工作区，不进发布目录）
.release-manifest.json
